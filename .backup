ALTER TABLE public.world_members OWNER TO postgres;

--
-- Name: worlds; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.worlds (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    owner_id uuid NOT NULL,
    name text NOT NULL,
    slug text GENERATED ALWAYS AS (regexp_replace(lower(name), '[^a-z0-9]+'::text, '-'::text, 'g'::text)) STORED,
    description text,
    visibility text DEFAULT 'private'::text NOT NULL,
    is_archived boolean DEFAULT false NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    deleted_at timestamp with time zone,
    icon_url text,
    banner_url text,
    color text,
    CONSTRAINT worlds_visibility_check CHECK ((visibility = 'private'::text))
);


ALTER TABLE public.worlds OWNER TO postgres;


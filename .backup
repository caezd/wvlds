--
-- Name: get_balance_summary(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_balance_summary(p_user_id uuid) RETURNS TABLE(xp integer, coins integer, streak_current integer, streak_longest integer)
    LANGUAGE sql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
  select b.xp, b.coins, b.streak_current, b.streak_longest
  from public.gamification_balances b
  where b.user_id = p_user_id
    and (
      p_user_id = auth.uid()
      or exists (
        select 1
        from public.world_members a
        join public.world_members b2 on b2.world_id = a.world_id
        where a.user_id = auth.uid()
          and b2.user_id = p_user_id
      )
    );
$$;


ALTER FUNCTION public.get_balance_summary(p_user_id uuid) OWNER TO postgres;

--
-- Name: get_chatroom_unreads(uuid, uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_chatroom_unreads(u uuid, wid uuid) RETURNS TABLE(chat_id uuid, unread_messages integer)
    LANGUAGE sql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
  SELECT r.id AS chat_id,
         COUNT(m.*)::int AS unread_messages
  FROM public.chatrooms r
  LEFT JOIN public.chat_messages m
    ON m.chat_id = r.id
  LEFT JOIN public.chatroom_reads cr
    ON cr.chat_id = r.id AND cr.user_id = u
  WHERE r.world_id = wid
    AND (m.id IS NULL OR (m.author_id <> u AND (cr.last_read_at IS NULL OR m.created_at > cr.last_read_at)))
  GROUP BY r.id;
$$;


ALTER FUNCTION public.get_chatroom_unreads(u uuid, wid uuid) OWNER TO postgres;

--
-- Name: get_world_unreads(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_world_unreads(u uuid) RETURNS TABLE(world_id uuid, unread_messages integer, unread_rooms integer)
    LANGUAGE sql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
  WITH msgs AS (
    SELECT r.world_id, COUNT(*)::int AS c
    FROM public.chat_messages m
    JOIN public.chatrooms r ON r.id = m.chat_id
    LEFT JOIN public.chatroom_reads cr
      ON cr.chat_id = m.chat_id AND cr.user_id = u
    WHERE m.author_id <> u
      AND (cr.last_read_at IS NULL OR m.created_at > cr.last_read_at)
    GROUP BY r.world_id
  ),
  rooms AS (
    SELECT c.world_id, COUNT(*)::int AS c
    FROM public.chatrooms c
    LEFT JOIN public.world_member_reads wmr
      ON wmr.world_id = c.world_id AND wmr.user_id = u
    WHERE (wmr.last_seen_at IS NULL OR c.created_at > wmr.last_seen_at)
      AND c.created_by <> u
    GROUP BY c.world_id
  )
  SELECT w.id,
         COALESCE(msgs.c, 0),
         COALESCE(rooms.c, 0)
  FROM public.worlds w
  JOIN public.world_members wm ON wm.world_id = w.id AND wm.user_id = u
  LEFT JOIN msgs  ON msgs.world_id  = w.id
  LEFT JOIN rooms ON rooms.world_id = w.id;
$$;


ALTER FUNCTION public.get_world_unreads(u uuid) OWNER TO postgres;

--
-- Name: handle_new_user(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.handle_new_user() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
declare
  v_usern text := nullif(coalesce(new.raw_user_meta_data->>'username', null), '');
  v_avatar text := coalesce(new.raw_user_meta_data->>'avatar_url', null);
begin
  insert into public.profiles (id, email, username, avatar_url)
  values (
    new.id,
    new.email,
    v_usern,
    v_avatar
  )
  on conflict (id) do nothing;

  return new;
end
$$;


ALTER FUNCTION public.handle_new_user() OWNER TO postgres;

--
-- Name: has_persona_capacity(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.has_persona_capacity(u uuid) RETURNS boolean
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
declare c int;
begin
if public.is_subscribed(u) then
return true; -- unlimited
end if;
select count(*) into c from public.personas where user_id = u;
return c < 5; -- free limit
end; $$;


ALTER FUNCTION public.has_persona_capacity(u uuid) OWNER TO postgres;


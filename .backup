--
-- Name: chatrooms chatrooms update title by creator or editor; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "chatrooms update title by creator or editor" ON public.chatrooms FOR UPDATE TO authenticated USING (((created_by = auth.uid()) OR public.is_world_editor(world_id, auth.uid()))) WITH CHECK (((created_by = auth.uid()) OR public.is_world_editor(world_id, auth.uid())));


--
-- Name: chatrooms chatrooms: update by owner or world admin; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "chatrooms: update by owner or world admin" ON public.chatrooms FOR UPDATE TO authenticated USING (((created_by = auth.uid()) OR (EXISTS ( SELECT 1
   FROM public.world_members wm
  WHERE ((wm.world_id = chatrooms.world_id) AND (wm.user_id = auth.uid()) AND (wm.role = ANY (ARRAY['owner'::public.world_role, 'admin'::public.world_role]))))))) WITH CHECK (((created_by = auth.uid()) OR (EXISTS ( SELECT 1
   FROM public.world_members wm
  WHERE ((wm.world_id = chatrooms.world_id) AND (wm.user_id = auth.uid()) AND (wm.role = ANY (ARRAY['owner'::public.world_role, 'admin'::public.world_role])))))));



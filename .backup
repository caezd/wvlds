--
-- Name: recompute_summary_on_delete(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.recompute_summary_on_delete() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
declare
  v_last record;
  v_author_name    text;
  v_author_avatar  text;
  v_author_username text;
  v_persona_name   text;
begin
  select m.* into v_last
  from public.chat_messages m
  where m.chat_id = old.chat_id
  order by m.created_at desc, m.id desc
  limit 1;

  if v_last is not null then
    select p.full_name, p.avatar_url, p.username
      into v_author_name, v_author_avatar, v_author_username
    from public.profiles p
    where p.id = v_last.author_id;

    if v_last.persona_id is not null then
      select pe.name into v_persona_name
      from public.personas pe
      where pe.id = v_last.persona_id;
    end if;

    update public.chatroom_summaries s set
      last_message_id = v_last.id,
      last_message_at = v_last.created_at,
      last_message_excerpt = public.msg_excerpt(v_last.content, 140),
      last_message_author_id = v_last.author_id,
      last_message_author_name = coalesce(v_author_name, 'Utilisateur'),
      last_message_author_username = v_author_username,
      last_message_author_avatar_url = v_author_avatar,
      last_message_persona_id = v_last.persona_id,
      last_message_persona_name = v_persona_name
    where s.chat_id = old.chat_id;

    update public.chatrooms c set updated_at = v_last.created_at where c.id = old.chat_id;
  else
    delete from public.chatroom_summaries where chat_id = old.chat_id;
  end if;

  return old;
end;
$$;


ALTER FUNCTION public.recompute_summary_on_delete() OWNER TO postgres;

--
-- Name: search_users_for_world(uuid, text, integer); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.search_users_for_world(p_world uuid, p_q text, p_limit integer DEFAULT 10) RETURNS TABLE(user_id uuid, email text, username text)
    LANGUAGE sql STABLE SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
  select u.id as user_id, u.email, p.username
  from auth.users u
  join public.profiles p on p.id = u.id
  where public.is_world_admin(p_world, auth.uid()) -- seul owner/admin peut chercher
    and (
      lower(u.email) like '%'||lower(p_q)||'%' or
      (p.username is not null and lower(p.username) like '%'||lower(p_q)||'%')
    )
    -- exclure les membres déjà présents
    and not exists (
      select 1 from public.world_members wm
      where wm.world_id = p_world and wm.user_id = u.id
    )
  order by
    case when lower(u.email) = lower(p_q) then 0 else 1 end,
    u.email
  limit greatest(coalesce(p_limit,10), 1)
$$;


ALTER FUNCTION public.search_users_for_world(p_world uuid, p_q text, p_limit integer) OWNER TO postgres;


--

CREATE FUNCTION public.msg_excerpt(txt text, max_len integer) RETURNS text
    LANGUAGE sql STABLE
    AS $$
  select case when txt is null then null
    else left(regexp_replace(trim(txt), '\s+', ' ', 'g'), greatest(0, max_len)) end
$$;



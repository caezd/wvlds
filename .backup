-- Name: is_subscribed(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.is_subscribed(u uuid) RETURNS boolean
    LANGUAGE sql STABLE SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
select coalesce((select p.is_subscribed from public.profiles p where p.id = u), false);
$$;



--

CREATE TABLE public.chatroom_summaries (
    chat_id uuid NOT NULL,
    last_message_id bigint,
    last_message_at timestamp with time zone,
    last_message_excerpt text,
    last_message_author_id uuid,
    last_message_author_username text,
    last_message_persona_avatar_url text,
    last_message_persona_id uuid,
    last_message_persona_name text
);


ALTER TABLE public.chatroom_summaries OWNER TO postgres;

--
-- Name: chatrooms; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.chatrooms (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    world_id uuid NOT NULL,
    title text NOT NULL,
    created_by uuid NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    tag integer DEFAULT 0 NOT NULL,
    name text DEFAULT 'Nouvelle salle'::text NOT NULL,
    banner_url text,
    icon_url text
);


ALTER TABLE public.chatrooms OWNER TO postgres;

--
-- Name: gamification_balances; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.gamification_balances (
    user_id uuid NOT NULL,
    xp integer DEFAULT 0 NOT NULL,
    coins integer DEFAULT 0 NOT NULL,
    streak_current integer DEFAULT 0 NOT NULL,
    streak_longest integer DEFAULT 0 NOT NULL,
    last_active_day date
);


ALTER TABLE public.gamification_balances OWNER TO postgres;

--
-- Name: gamification_events; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.gamification_events (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    event_type text NOT NULL,
    ref_id text,
    meta jsonb DEFAULT '{}'::jsonb NOT NULL,
    xp integer DEFAULT 0 NOT NULL,
    coins integer DEFAULT 0 NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    created_day date GENERATED ALWAYS AS (((created_at AT TIME ZONE 'America/Toronto'::text))::date) STORED,
    CONSTRAINT gamification_events_event_type_check CHECK ((event_type = ANY (ARRAY['message_posted'::text, 'daily_login'::text, 'streak_by_message'::text])))
);


ALTER TABLE public.gamification_events OWNER TO postgres;

--
-- Name: personas; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.personas (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    user_id uuid NOT NULL,
    name text NOT NULL,
    bio text,
    avatar_url text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    deleted_at timestamp with time zone,
    CONSTRAINT personas_name_check CHECK (((char_length(name) >= 1) AND (char_length(name) <= 40)))
);


ALTER TABLE public.personas OWNER TO postgres;

--
-- Name: profiles; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.profiles (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    is_subscribed boolean DEFAULT false NOT NULL,
    plan text DEFAULT 'free'::text NOT NULL,
    username text,
    avatar_url text,
    last_world_id uuid,
    CONSTRAINT profiles_plan_check CHECK ((plan = ANY (ARRAY['free'::text, 'pro'::text, 'team'::text, 'lifetime'::text]))),
    CONSTRAINT profiles_username_format CHECK (((username IS NULL) OR (username ~ '^[A-Za-z0-9_]{3,32}$'::text)))
);


ALTER TABLE public.profiles OWNER TO postgres;


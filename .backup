--

CREATE POLICY "messages insert (member + persona owned)" ON public.chat_messages FOR INSERT TO authenticated WITH CHECK (((EXISTS ( SELECT 1
   FROM public.chatrooms c
  WHERE ((c.id = chat_messages.chat_id) AND public.is_world_member(c.world_id, auth.uid())))) AND public.owns_persona(persona_id, auth.uid())));


